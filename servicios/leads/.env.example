# Copiar a /home/deploy/leads/.env en el servidor (chmod 600, NUNCA al repo).
# Sin estas variables el servicio arranca igual: guarda los leads y deja los avisos en cola
# hasta que esten. Al completarlas, reiniciar el contenedor y la cola se vacia sola.

# Telegram: crear el bot con @BotFather; escribirle un mensaje y sacar el chat_id de
# https://api.telegram.org/bot<TOKEN>/getUpdates  ->  result[0].message.chat.id
LEADS_TELEGRAM_TOKEN=
LEADS_TELEGRAM_CHAT_ID=

# Correo por Gmail: requiere 2FA y una "contrasena de aplicacion" (no la clave de la cuenta).
LEADS_SMTP_HOST=smtp.gmail.com
LEADS_SMTP_PUERTO=587
LEADS_SMTP_USUARIO=
LEADS_SMTP_CLAVE=
LEADS_SMTP_REMITENTE=
LEADS_SMTP_DESTINO=
